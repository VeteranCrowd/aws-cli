{
  "defaultFormat": {
    "eachLine": {
      "prepend": "# "
    }
  },
  "ignore": ["license.txt", ".lefthook/"],
  "ignoreFile": "./.gitignore",
  "license": "./license.txt",
  "licenseFormats": {
    "md": {
      "eachLine": {
        "prepend": "[//]: # (",
        "append": ")"
      }
    },
    "hbs|html|xml|svg": {
      "prepend": "<!--",
      "append": "-->\n"
    },
    "js|ts|css|scss|less|php|as|c|java|cpp|go|cto|acl|babelrc": {
      "prepend": "/*",
      "append": "*/\n"
    }
  },
  "trailingWhitespace": "TRIM"
}
