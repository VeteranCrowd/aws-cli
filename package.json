{
  "name": "@veterancrowd/aws-cli",
  "bin": {
    "vc": "bin/vc/index.js"
  },
  "version": "6.2.1",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/veterancrowd/aws-cli"
  },
  "author": "Jason G. Williscroft",
  "bugs": {
    "url": "https://github.com/veterancrowd/aws-cli/issues"
  },
  "description": "An ES6 NPM package project template featuring a CLI, test support, automated API docs, release management & more!",
  "homepage": "https://github.com/veterancrowd/aws-cli#readme",
  "keywords": [
    "aws"
  ],
  "license": "BSD-3-Clause",
  "dependencies": {
    "@aws-sdk/client-amplify": "^3.844.0",
    "@aws-sdk/client-api-gateway": "^3.844.0",
    "@aws-sdk/client-application-auto-scaling": "^3.844.0",
    "@aws-sdk/client-cloudformation": "^3.844.0",
    "@aws-sdk/client-cloudwatch": "^3.844.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.844.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.844.0",
    "@inquirer/confirm": "^3.2.0",
    "@karmaniverous/edge-logger": "^1.3.12",
    "@karmaniverous/get-dotenv": "^4.5.2",
    "@veterancrowd/wrapped-dynamodb-client": "^1.6.23",
    "@veterancrowd/wrapped-secrets-manager-client": "^0.4.24",
    "@veterancrowd/wrapped-sqs-client": "^0.5.10",
    "commander": "^14.0.1",
    "depcheck": "^1.4.7",
    "depcheck-parser-babel": "^3.0.57",
    "execa": "^9.6.0",
    "exponential-backoff": "^3.1.2",
    "fs-extra": "^11.3.0",
    "git-branch": "^2.0.1",
    "globby": "^14.1.0",
    "lodash": "^4.17.21",
    "pkg-dir": "^8.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.0",
    "@babel/core": "^7.28.0",
    "@babel/eslint-parser": "^7.28.0",
    "@babel/plugin-syntax-import-assertions": "^7.27.1",
    "@babel/preset-env": "^7.28.0",
    "@babel/register": "^7.27.1",
    "auto-changelog": "^2.5.0",
    "babel-plugin-lodash": "^3.3.4",
    "chai": "^5.2.1",
    "concat-md": "^0.5.1",
    "crlf": "^1.1.1",
    "eslint": "=8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^48.11.0",
    "eslint-plugin-mocha": "^10.5.0",
    "eslint-plugin-promise": "^6.6.0",
    "jsdoc-to-markdown": "^8.0.3",
    "knip": "^5.61.3",
    "lefthook": "^1.12.1",
    "license-check-and-add": "^4.0.5",
    "mocha": "^10.8.2",
    "release-it": "^17.11.0"
  },
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./dist/default/lib/index.js"
    }
  },
  "main": "./lib/index.js",
  "mocha": {
    "exclude": [
      "./dist/**",
      "./node_modules/**"
    ],
    "file": "./test/setup.js",
    "require": [
      "@babel/register"
    ],
    "spec": "./**/*.test.!(*.*)",
    "timeout": 60000
  },
  "release-it": {
    "git": {
      "changelog": "npx auto-changelog --stdout --commit-limit false -u --template https://raw.githubusercontent.com/release-it/release-it/main/templates/changelog-compact.hbs",
      "requireBranch": "dev",
      "commitMessage": "chore: release v${version}"
    },
    "github": {
      "release": true,
      "skipChecks": true
    },
    "hooks": {
      "after:init": [
        "nr lint",
        "nr build"
      ],
      "after:release": [
        "git switch -c release/${version}",
        "git push -u origin release/${version}",
        "git switch ${branchName}"
      ]
    },
    "npm": {
      "publish": true
    }
  },
  "scripts": {
    "build": "babel lib -d dist/default/lib --delete-dir-on-start --config-file ./dist/default/.babelrc",
    "cli": "node ./bin/vc",
    "knip": "knip",
    "lint": "eslint lib/** bin/**",
    "release": "node ./bin/vc release-it",
    "release:pre": "node ./bin/vc release-it --no-git.requireBranch --github.prerelease --preRelease",
    "test": "node ./bin/vc mocha"
  },
  "type": "module",
  "files": [
    "lib",
    "dist",
    "bin"
  ]
}
